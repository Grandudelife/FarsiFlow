{
  "manifest_version": 3,
  "name": "FarsiFlow | فارسی‌یار",
  "version": "1.0.4",
  "description": "فونت فارسی دلخواه و نمایش خوانای متن فارسی و انگلیسی؛ بهینه برای ChatGPT، Gemini و Claude.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "FarsiFlow | فارسی‌یار", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "web_accessible_resources": [{"resources": ["fonts/*.woff2"], "matches": ["http://*/*", "https://*/*"]}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
